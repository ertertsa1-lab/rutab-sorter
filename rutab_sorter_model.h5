_١٥١٦١٦.jpg  \n","  inflating: /content/dataset/Dates_Dataset/Good/٢٠٢٦٠٩٠١_١٥١٦٢٩.jpg  \n","  inflating: /content/dataset/Dates_Dataset/Good/٢٠٢٦٠٩٠١_١٥١٦٥٤.jpg  \n","  inflating: /content/dataset/Dates_Dataset/Good/٢٠٢٦٠٩٠١_١٥١٧٤٧.jpg  \n","  inflating: /content/dataset/Dates_Dataset/Good/٢٠٢٦٠٩٠١_١٥١٨٠١.jpg  \n","  inflating: /content/dataset/Dates_Dataset/Good/٢٠٢٦٠٩٠١_١٥١٨٢٣.jpg  \n"]}]},{"cell_type":"code","source":["استورد  tensorflow  كـ  tf\n","من  tensorflow.keras.preprocessing.image  استورد  ImageDataGenerator\n","من  tensorflow.keras.applications  استورد  MobileNetV2\n","من  tensorflow.keras.layers  استورد  Dense و GlobalAveragePooling2D\n","من  tensorflow.keras.models  استورد  Model\n","استورد  matplotlib.pyplot  كـ  plt\n","\n","# 1. تحديد مسار الصور وتطبيق تقنية (Data Augmentation)\n","# هذه التقنية تقوم بتدوير الصور وقلب الصور برمجياً باستثناء نسخها وتطبيق النموذج أذكى\n","dataset_path =  '/content/dataset/Dates_Dataset' #تأكد أن هذا هو اسم المجلد المستخرج\n","\n","datagen = ImageDataGenerator(\n","    rescale= 1 ./ 255 ,            # توحيد ألوان الصور\n","    Rotation_range= 30 ,         # دمج الصور 30 ​​درجة\n","    أفقية_flip= True ,      # تحويل الصور بصريا\n","    validation_split= 0.2 # عزل 20% من الصور الجزئية الدقيقة أثناء التدريب\n",")\n","\n","print ( \"جاري تحميل صور التدريب:\" )\n","Train_data = datagen.flow_from_directory(\n","    dataset_path,\n","    target_size=( 224 ,  224 ),    #الحجم القياسي الذي يفهمه MobileNetV2\n","    Batch_size= 32 ,\n","    class_mode= 'binary' ,       # نوع نصنف بين (جيد) و (فاسد) فقط\n","    subset= 'training'\n",")\n","\n","print ( \"جاري تحميل صور الاختبار:\" )\n","val_data = datagen.flow_from_directory(\n","    dataset_path,\n","    target_size=( 224 ,  224 ),\n","    batch_size= 32 ,\n","    class_mode= 'binary' ,\n","    subset= 'validation'\n",")\n","\n","# 2. الاتصال بنموذج MobileNetV2 المتقدم للتدريب\n","base_model = MobileNetV2(weights= 'imagenet' , include_top= False , input_shape=( 224 ,  224 ,  3 ))\n","base_model.trainable =  False # تجميد الطبقة الرئيسية الرئيسية وقت التدريب\n","\n","# 3. إضافة عقل جديد للنموذج ليتخصص في المختبر\n","x = base_model.output\n","x = GlobalAveragePooling2D()(x)\n","x = Dense( 128 ,activation= 'relu' )(x)\n","التنبؤات = Dense( 1 ,activation= 'sigmoid' )(x)  # النتيجة النهائية: 0 (مثلاً فاسد) أو 1 (جيد)\n","\n","model = Model(inputs=base_model.input, outputs=predictions )\n","\n","# 4. تجميع نموذج وضبط إعدادات\n","نموذج التعلم. ترجمة (optimizer=tf.keras.optimizers.Adam(learning_rate= 0.001 )،\n","              Loss= 'binary_crossentropy' ،\n","              metrics=[ 'accuracy' ])\n","\n","# 5. بدء التدريب (سيستغرق بعض الوقت حسب عدد الصور)\n","print ( \"\\n--- بدء تشغيل التدريب ---\" )\n","History = model.fit(\n","    Train_data,\n","    validation_data=val_data,\n","    epochs= 15 # عدد المتزايد المتزايد (يمكنك زيادتها إلى 20 إذا أردت أن تكون أكثر تأكيدًا)\n",")\n","\n","# 6. حفظ النموذج النهائي كملف الليزر تنزيله وربطه بالآلة\n","model.save( '/content/rutab_sorter_model.h5' )\n","print ( \"\\nتم التدريب الفعال! حفظ النموذج باسم: rutab_sorter_model.h5\" )"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":106},"id":"9X8EbVp0yu6s","executionInfo":{"status":"error","timestamp":1793396621623,"user_tz":-240,"elapsed":42,"user":{"displayName":"أحمد الجساسي","userId":"16713822199675476770"}},"outputId":"6e2dc583-136c-48e7-9ffe-7afb6b004800","collapsed":true},"execution_count":73,"outputs":[{"output_type":"error","ename":"SyntaxError","evalue":"invalid character '،' (U+060C) (913515299.py, line 50)","traceback":["\u001b[0;36m  File \u001b[0;32m\"/tmp/ipykernel_469/913515299.py\"\u001b[0;36m, line \u001b[0;32m50\u001b[0m\n\u001b[0;31m    نموذج التعلم. ترجمة (optimizer=tf.keras.optimizers.Adam(learning_rate= 0.001 )،\u001b[0m\n\u001b[0m                                                                                  ^\u001b[0m\n\u001b[0;31mSyntaxError\u001b[0m\u001b[0;31m:\u001b[0m invalid character '،' (U+060C)\n"]}]},{"cell_type":"code","source":["import tensorflow as tf\n","from tensorflow.keras.preprocessing.image import ImageDataGenerator\n","from tensorflow.keras.applications import MobileNetV2\n","from tensorflow.keras.layers import Dense, GlobalAveragePooling2D\n","from tensorflow.keras.models import Model\n","import matplotlib.pyplot as plt\n","\n","# 1. تحديد مسار الصور وتطبيق تقنية (Data Augmentation)\n","dataset_path = '/content/dataset/Dates_Dataset'\n","\n","datagen = ImageDataGenerator(\n","    rescale=1.0 / 255,          # توحيد ألوان الصور\n","    rotation_range=30,          # دمج الصور 30 درجة\n","    horizontal_flip=True,       # تحويل الصور بصرياً\n","    validation_split=0.2        # عزل 20% من الصور الجزئية الدقيقة أثناء التدريب\n",")\n","\n","print(\"جاري تحميل صور التدريب...\")\n","Train_data = datagen.flow_from_directory(\n","    dataset_path,\n","    target_size=(224, 224),\n","    batch_size=32,              # تم تصحيح الحرف ليصبح بحرف صغير\n","    class_mode='binary',\n","    subset='training'\n",")\n","\n","print(\"جاري تحميل صور الاختبار...\")\n","val_data = datagen.flow_from_directory(\n","    dataset_path,\n","    target_size=(224, 224),\n","    batch_size=32,              # تم تصحيح الحرف ليصبح بحرف صغير\n","    class_mode='binary',\n","    subset='validation'\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"collapsed":true,"id":"vF9v8wwSkZMU","executionInfo":{"status":"ok","timestamp":1793396625001,"user_tz":-240,"elapsed":56,"user":{"displayName":"أحمد الجساسي","userId":"16713822199675476770"}},"outputId":"c7c94f1a-6477-42d1-f104-d80eaee7b648"},"execution_count":74,"outputs":[{"output_type":"stream","name":"stdout","text":["جاري تحميل صور التدريب...\n","Found 54 images belonging to 2 classes.\n","جاري تحميل صور الاختبار...\n","Found 12 images belonging to 2 classes.\n"]}]},{"cell_type":"code","source":["import numpy as np\n","import tensorflow as tf\n","from tensorflow.keras.preprocessing import image\n","\n","# 1. تحميل نموذج الذكاء الاصطناعي\n","model = tf.keras.models.load_model('/content/rutab_sorter_model.h5')\n","\n","# 2. تم إضافة علامات التنصيص حول المسار\n","img_path = '/content/11.jpg'\n","\n","# 3. معالجة الصورة لتناسب أبعاد التدريب\n","img = image.load_img(img_path, target_size=(224, 224))\n","img_array = image.img_to_array(img)\n","img_array = np.expand_dims(img_array, axis=0)\n","img_array /= 255.0\n","\n","# 4. توجيه النموذج لفحص الصورة\n","prediction = model.predict(img_array)\n","\n","# 5. طباعة النتيجة\n","if prediction[0][0] > 0.5:\n","    print(\"🟢 النتيجة: هذا الرطب جيد (سليم ومناسب للبيع)\")\n","else:\n","    print(\"🔴 النتيجة: هذا الرطب فاسد (يجب استبعاده)\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":349},"id":"LW0ANMRrWjAZ","executionInfo":{"status":"error","timestamp":1793396629824,"user_tz":-240,"elapsed":1946,"user":{"displayName":"أحمد الجساسي","userId":"16713822199675476770"}},"outputId":"e9640154-14b1-47e3-b5b8-98755e8e8b47"},"execution_count":75,"outputs":[{"output_type":"stream","name":"stderr","text":["WARNING:absl:Compiled the loaded model, but the compiled metrics have yet to be built. `model.compile_metrics` will be empty until you train or evaluate the model.\n"]},{"output_type":"error","ename":"FileNotFoundError","evalue":"[Errno 2] No such file or directory: '/content/11.jpg'","traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mFileNotFoundError\u001b[0m                         Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_469/1087151608.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m     10\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     11\u001b[0m \u001b[0;31m# 3. معالجة الصورة لتناسب أبعاد التدريب\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m---> 12\u001b[0;31m \u001b[0mimg\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mimage\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mload_img\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mimg_path\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mtarget_size\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;36m224\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;36m224\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m     13\u001b[0m \u001b[0mimg_array\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mimage\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mimg_to_array\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mimg\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     14\u001b[0m \u001b[0mimg_array\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mnp\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mexpand_dims\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mimg_array\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0maxis\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;36m0\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/usr/local/lib/python3.13/dist-packages/keras/src/utils/image_utils.py\u001b[0m in \u001b[0;36mload_img\u001b[0;34m(path, color_mode, target_size, interpolation, keep_aspect_ratio)\u001b[0m\n\u001b[1;32m    245\u001b[0m         \u001b[0;32mif\u001b[0m \u001b[0misinstance\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mpath\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mpathlib\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mPath\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    246\u001b[0m             \u001b[0mpath\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mstr\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mpath\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mresolve\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 247\u001b[0;31m         \u001b[0;32mwith\u001b[0m \u001b[0mopen\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mpath\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m\"rb\"\u001b[0m\u001b[0;34m)\u001b[0m \u001b[0;32mas\u001b[0m \u001b[0mf\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    248\u001b[0m             \u001b[0mimg\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mpil_image\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mopen\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mio\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mBytesIO\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mf\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mread\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    249\u001b[0m     \u001b[0;32melse\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mFileNotFoundError\u001b[0m: [Errno 2] No such file or directory: '/content/11.jpg'"]}]},{"cell_type":"code","source":["import tensorflow as tf\n","from tensorflow.keras.applications import MobileNetV2\n","from tensorflow.keras.layers import Dense, GlobalAveragePooling2D\n","from tensorflow.keras.models import Model\n","\n","# 2. بناء نموذج MobileNetV2 للتدريب المتقدم\n","base_model = MobileNetV2(weights='imagenet', include_top=False, input_shape=(224, 224, 3))\n","base_model.trainable = False  # تجميد الطبقة الرئيسية لتبدأ عملية التعلم بدقة\n","\n","# إضافة الطبقات الجديدة المخصصة لفرز التمور\n","x = base_model.output\n","x = GlobalAveragePooling2D()(x)\n","x = Dense(128, activation='relu')(x)\n","predictions = Dense(1, activation='sigmoid')(x)  # النتيجة النهائية: 0 (فاسد) أو 1 (جيد)\n","\n","model = Model(inputs=base_model.input, outputs=predictions)\n","\n","# تجميع النموذج وضبط إعدادات التدريب\n","model.compile(\n","    optimizer=tf.keras.optimizers.Adam(learning_rate=0.001),\n","    loss='binary_crossentropy',\n","    metrics=['accuracy']\n",")\n","\n","# 3. بدء التدريب (سيستغرق بضع دقائق حسب عدد الصور لديك)\n","print(\"--- بدأ تشغيل التدريب الآن ---\")\n","history = model.fit(\n","    Train_data,\n","    validation_data=val_data,\n","    epochs=15  # عدد الدورات التدريبية\n",")\n","\n","# 4. حفظ النموذج النهائي ليمكن استخدامه في التطبيق والآلة\n","model.save('/content/rutab_sorter_model.h5')\n","print(\"✅ تم التدريب بنجاح! وحفظ الملف باسم rutab_sorter_model.h5\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Qhxj8v01nsYO","executionInfo":{"status":"ok","timestamp":1793396835208,"user_tz":-240,"elapsed":201644,"user":{"displayName":"أحمد الجساسي","userId":"16713822199675476770"}},"outputId":"5b623e0c-45b6-4572-e011-21e1b6d28239"},"execution_count":76,"outputs":[{"output_type":"stream","name":"stdout","text":["--- بدأ تشغيل التدريب الآن ---\n","Epoch 1/15\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m24s\u001b[0m 9s/step - accuracy: 0.5926 - loss: 0.7287 - val_accuracy: 0.9167 - val_loss: 0.3386\n","Epoch 2/15\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m12s\u001b[0m 6s/step - accuracy: 0.8519 - loss: 0.3689 - val_accuracy: 0.7500 - val_loss: 0.4021\n","Epoch 3/15\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m9s\u001b[0m 6s/step - accuracy: 0.9815 - loss: 0.1841 - val_accuracy: 1.0000 - val_loss: 0.1517\n","Epoch 4/15\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m11s\u001b[0m 4s/step - accuracy: 0.9444 - loss: 0.1333 - val_accuracy: 0.9167 - val_loss: 0.1521\n","Epoch 5/15\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m13s\u001b[0m 9s/step - accuracy: 1.0000 - loss: 0.0673 - val_accuracy: 1.0000 - val_loss: 0.1529\n","Epoch 6/15\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m11s\u001b[0m 7s/step - accuracy: 1.0000 - loss: 0.0474 - val_accuracy: 1.0000 - val_loss: 0.0843\n","Epoch 7/15\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m10s\u001b[0m 5s/step - accuracy: 1.0000 - loss: 0.0430 - val_accuracy: 0.9167 - val_loss: 0.1985\n","Epoch 8/15\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m12s\u001b[0m 4s/step - accuracy: 1.0000 - loss: 0.0197 - val_accuracy: 1.0000 - val_loss: 0.0756\n","Epoch 9/15\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m14s\u001b[0m 10s/step - accuracy: 1.0000 - loss: 0.0113 - val_accuracy: 1.0000 - val_loss: 0.0711\n","Epoch 10/15\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m10s\u001b[0m 6s/step - accuracy: 1.0000 - loss: 0.0139 - val_accuracy: 1.0000 - val_loss: 0.0866\n","Epoch 11/15\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m11s\u001b[0m 5s/step - accuracy: 1.0000 - loss: 0.0097 - val_accuracy: 1.0000 - val_loss: 0.0525\n","Epoch 12/15\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m20s\u001b[0m 7s/step - accuracy: 1.0000 - loss: 0.0075 - val_accuracy: 1.0000 - val_loss: 0.0204\n","Epoch 13/15\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m10s\u001b[0m 4s/step - accuracy: 1.0000 - loss: 0.0045 - val_accuracy: 1.0000 - val_loss: 0.0149\n","Epoch 14/15\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m12s\u001b[0m 4s/step - accuracy: 1.0000 - loss: 0.0026 - val_accuracy: 0.9167 - val_loss: 0.1288\n","Epoch 15/15\n","\u001b[1m2/2\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m14s\u001b[0m 10s/step - accuracy: 1.0000 - loss: 0.0042 - val_accuracy: 1.0000 - val_loss: 0.0620\n"]},{"output_type":"stream","name":"stderr","text":["WARNING:absl:You are saving your model as an HDF5 file via `model.save()` or `keras.saving.save_model(model)`. This file format is considered legacy. We recommend using instead the native Keras format, e.g. `model.save('my_model.keras')` or `keras.saving.save_model(model, 'my_model.keras')`. \n"]},{"output_type":"stream","name":"stdout","text":["✅ تم التدريب بنجاح! وحفظ الملف باسم rutab_sorter_model.h5\n"]}]},{"cell_type":"code","source":["import gradio as gr\n","import numpy as np\n","import tensorflow as tf\n","\n","# 1. تحميل النموذج (تأكد أن الملف موجود في مجلد /content/)\n","try:\n","    model = tf.keras.models.load_model('/content/rutab_sorter_model.h5')\n","except:\n","    print(\"⚠️ تنبيه: لم يتم العثور على ملف النموذج. تأكد من تشغيل خلية التدريب أولاً!\")\n","\n","# 2. دالة التوقع مع دعم اللغتين\n","def predict_rutab(img, lang):\n","    if img is None:\n","        return \"الرجاء رفع صورة أولاً\" if lang == \"العربية\" else \"Please upload an image first.\"\n","\n","    img = img.resize((224, 224))\n","    img_array = np.array(img) / 255.0\n","    img_array = np.expand_dims(img_array, axis=0)\n","\n","    prediction = model.predict(img_array)\n","    score = prediction[0][0]\n","\n","    # --- زيادة الصرامة هنا ---\n","    # جعلنا الحد الأدنى للحكم بأنه \"جيد\" هو 0.75 (أي صارم ضد العيوب)\n","    strictness_threshold = 0.90\n","\n","    # إذا كانت النتيجة أقل من الحد الصارم، سيتم اعتباره فاسداً واستبعاده\n","    is_bad = score < strictness_threshold\n","\n","    if lang == \"العربية\":\n","        if is_bad:\n","            return f\"🔴 النتيجة: هذا الرطب فاسد - يجب استبعاده (النسبة: {score:.2f})\"\n","        else:\n","            return f\"🟢 النتيجة: هذا الرطب جيد ومناسب للبيع (النسبة: {score:.2f})\"\n","    else:\n","        if is_bad:\n","            return f\"🔴 Result: Bad - Needs to be discarded (Score: {score:.2f})\"\n","        else:\n","            return f\"🟢 Result: Good - Suitable for sale (Score: {score:.2f})\"\n","# 3. تنسيق CSS لضبط الاتجاه من اليمين وتصغير قائمة اللغة\n","custom_css = \"\"\"\n","body, .gradio-container {\n","    direction: rtl !important;\n","    text-align: right !important;\n","    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n","}\n",".small-lang {\n","    max-width: 130px !important;\n","    margin-left: 0 !important;\n","    margin-right: auto !important;\n","}\n","\"\"\"\n","\n","# 4. بناء الواجهة مع ترتيب العناصر (الصورة على اليمين والنتيجة على اليسار)\n","with gr.Blocks(css=custom_css, title=\"نظام فحص وفرز الرطب الآلي\") as app:\n","\n","    # رأس الصفحة: العنوان و زر تغيير اللغة الصغير\n","    with gr.Row():\n","        gr.Markdown(\"# 🌴 نظام فحص وفرز الرطب الآلي\")\n","        lang_selector = gr.Dropdown(\n","            choices=[\"العربية\", \"English\"],\n","            value=\"العربية\",\n","            label=\"اللغة\",\n","            elem_classes=\"small-lang\"\n","        )\n","\n","    gr.Markdown(\"ارفع صورة حبة الرطب أو التقطها بكاميرا الهاتف، وسيخبرك الذكاء الاصطناعي بنتيجتها فوراً.\")\n","\n","    # القسم الرئيسي: العمود الأيمن للصورة، والعمود الأيسر للنتيجة\n","    with gr.Row():\n","        # العمود الأيمن (تحت وعلى اليمين): إدخال الصورة وزر الفحص\n","        with gr.Column():\n","            image_input = gr.Image(type=\"pil\", label=\"إدخال الصورة (رفع أو كاميرا)\")\n","            submit_btn = gr.Button(\"فحص الصورة 🔍\", variant=\"primary\")\n","\n","        # العمود الأيسر: النتيجة\n","        with gr.Column():\n","            output_text = gr.Textbox(label=\"نتيجة الفحص\", interactive=False)\n","\n","    submit_btn.click(fn=predict_rutab, inputs=[image_input, lang_selector], outputs=output_text)\n","\n","# تشغيل التطبيق وتوليد الرابط\n","app.launch(share=True)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":663},"id":"EODe8wNYuV0f","executionInfo":{"status":"ok","timestamp":1793396845103,"user_tz":-240,"elapsed":3562,"user":{"displayName":"أحمد الجساسي","userId":"16713822199675476770"}},"outputId":"293b2f00-4fd4-48e5-c74b-5dd7e917e902"},"execution_count":77,"outputs":[{"output_type":"stream","name":"stderr","text":["WARNING:absl:Compiled the loaded model, but the compiled metrics have yet to be built. `model.compile_metrics` will be empty until you train or evaluate the model.\n","/tmp/ipykernel_469/990324143.py:55: UserWarning: The parameters have been moved from the Blocks constructor to the launch() method in Gradio 6.0: css. Please pass these parameters to launch() instead.\n","  with gr.Blocks(css=custom_css, title=\"نظام فحص وفرز الرطب الآلي\") as app:\n"]},{"output_type":"stream","name":"stdout","text":["Colab notebook detected. To show errors in colab notebook, set debug=True in launch()\n","* Running on public URL: https://a47d88901b262d6e85.gradio.live\n","\n","This share link is temporary and will last for up to 1 week (best effort). For free permanent hosting and GPU upgrades, run `gradio deploy` from the terminal in the working directory to deploy to Hugging Face Spaces (https://huggingface.co/spaces)\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["<div><iframe src=\"https://a47d88901b262d6e85.gradio.live\" width=\"100%\" height=\"500\" allow=\"autoplay; camera; microphone; clipboard-read; clipboard-write;\" frameborder=\"0\" allowfullscreen></iframe></div>"]},"metadata":{}},{"output_type":"execute_result","data":{"text/plain":[]},"metadata":{},"execution_count":77}]}]}